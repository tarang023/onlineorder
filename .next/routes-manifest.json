{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/customer-account-order-history",
      "regex": "^/customer\\-account\\-order\\-history(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-account\\-order\\-history(?:/)?$"
    },
    {
      "page": "/customer-login-register",
      "regex": "^/customer\\-login\\-register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/customer\\-login\\-register(?:/)?$"
    },
    {
      "page": "/item-detail-customization",
      "regex": "^/item\\-detail\\-customization(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/item\\-detail\\-customization(?:/)?$"
    },
    {
      "page": "/kitchen-display-system",
      "regex": "^/kitchen\\-display\\-system(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kitchen\\-display\\-system(?:/)?$"
    },
    {
      "page": "/menu-browse-search",
      "regex": "^/menu\\-browse\\-search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/menu\\-browse\\-search(?:/)?$"
    },
    {
      "page": "/order-tracking-status",
      "regex": "^/order\\-tracking\\-status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/order\\-tracking\\-status(?:/)?$"
    },
    {
      "page": "/restaurant-admin-dashboard",
      "regex": "^/restaurant\\-admin\\-dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restaurant\\-admin\\-dashboard(?:/)?$"
    },
    {
      "page": "/shopping-cart-checkout",
      "regex": "^/shopping\\-cart\\-checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shopping\\-cart\\-checkout(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}